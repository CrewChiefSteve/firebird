{
  "expo": {
    "name": "Trans Am",
    "slug": "firebird",
    "owner": "crewchiefsteve",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "firebird",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.crewchiefsteve.firebird",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.crewchiefsteve.firebird",
      "adaptiveIcon": {
        "backgroundColor": "#B5432A",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "@clerk/expo",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#B5432A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Trans Am uses your photos for build log posts and receipts.",
          "cameraPermission": "Trans Am uses the camera to shoot build log photos and receipts.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
